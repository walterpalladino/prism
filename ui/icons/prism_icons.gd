## Lookup for the UI icon set in res://ui/icons/ (white 24x24 SVGs tinted by the theme).
## Most are Pixelarticons 2.4.2 (MIT, see CREDITS.md); line, fill and rotate are
## project-owned, generated by tools/gen_icons.py.
class_name PrismIcons
extends RefCounted

const DIR: String = "res://ui/icons/"


static func has_icon(icon_name: String) -> bool:
	return ResourceLoader.exists(DIR + icon_name + ".svg")


## The icon texture, or null if there is no icon with that name.
static func get_icon(icon_name: String) -> Texture2D:
	if not has_icon(icon_name):
		return null
	return load(DIR + icon_name + ".svg") as Texture2D
